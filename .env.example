# Copy to .env and fill in. Never commit .env.

# Which model backend the agent uses: gemini | apertus
MODEL_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Apertus via OpenAI-compatible endpoint (provider TBD, see NOTES.md)
APERTUS_API_KEY=
APERTUS_BASE_URL=
APERTUS_MODEL_ID=

# Switzerland Tourism OpenData API (free key: https://developer.myswitzerland.io)
MYSWITZERLAND_API_KEY=

# Default search centre (WGS84). Example: Lugano. Put your real centre in .env.
SEARCH_LAT=46.005
SEARCH_LON=8.953
